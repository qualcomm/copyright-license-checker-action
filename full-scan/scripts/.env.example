#
# Sample environment for scripts/jira_scan.py. Copy to `.env` and fill in real
# values. `.env` (and any *.env) is gitignored, so secrets stay out of git.
# Real environment variables override anything set here.
#
# Names match qnaro's so the same values can be reused.

# --- Jira (Basic auth) ---
# JIRA_API_SERVER is the REST base and MUST include any context path (the trailing
# /jira): REST calls go to <JIRA_API_SERVER>/rest/api/2/... . Omitting /jira 404s.
# It defaults to the value below, so you usually only need the username/password.
JIRA_API_SERVER=https://jira-dc-tools.qualcomm.com/jira
# JIRA_USER / JIRA_PASSWORD are optional here: if unset, jira_scan falls back to your
# ~/.jira-creds file (line 1 = username, line 2 = password), the same file djira uses.
# Set them only to override that file.
JIRA_USER=
JIRA_PASSWORD=

# --- Comment size (optional) ---
# OSSOPS Jira rejects comments longer than this; jira_scan truncates to fit.
MAX_COMMENT_LENGTH=16384

# --- Comment visibility (optional) ---
# Restrict the posted comment so only members of this Jira group can see it, via
# the comment's visibility field. Leave blank/unset for a public comment. Set to
# 'developers' to keep scan output off the ticket for reporters/watchers outside
# that group. Overridden per-run by --comment-visibility-group.
# JIRA_COMMENT_VISIBILITY_GROUP=developers

# --- GitHub clone auth (optional; needed for private / Enterprise repos) ---
GITHUB_TOKEN=

# --- Corporate SSL (optional) ---
# CA bundle used for the Jira API and passed to git as GIT_SSL_CAINFO.
REQUESTS_CA_BUNDLE=
